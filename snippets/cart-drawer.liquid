{% doc %}
  Renders reusable cart drawer markup for both initial page loads and Section Rendering API responses.

  @param {boolean} [render_wrapper] - When true, wraps the drawer in the section wrapper that the Section Rendering API adds automatically.
{% enddoc %}

{%- liquid
  assign render_wrapper = render_wrapper | default: true, allow_false: true
-%}

{%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
  {% if render_wrapper %}
    <div
      id="shopify-section-cart-drawer-section"
      class="shopify-section"
    >
  {% endif %}

  <script
    type="module"
    src="{{ 'cart-drawer.js' | asset_url }}"
    fetchpriority="low"
  ></script>

  {% capture empty_cart_drawer_content %}
    <div
      class="cart-drawer__content"
      aria-label="{{ 'accessibility.cart' | t }}"
    >
      <h2
        class="theme-drawer__title h4"
        id="cart-drawer-heading"
      >
        {{ 'content.your_cart_is_empty' | t }}
      </h2>

      <div class="cart-drawer__items">
        {% render 'cart-products', force_empty: true, context: 'drawer' %}
      </div>
    </div>
  {% endcapture %}

  <theme-drawer
    id="cart-drawer"
    data-skip-node-update
  >
    <dialog
      ref="panel"
      class="theme-drawer__dialog color-custom-drawer"
      aria-labelledby="cart-drawer-heading"
      cart-summary-sticky="true"
    >
      <cart-drawer-component
        {% if settings.auto_open_cart_drawer and template.name != 'cart' %}
          auto-open
        {% endif %}
      >
        <template id="empty-cart-template">
          {{ empty_cart_drawer_content }}
        </template>

        <div
          class="cart-drawer__inner{% if cart.empty? %} cart-drawer--empty{% endif %}"
          data-hydration-key="cart-drawer-inner"
        >
          {%- if cart.empty? -%}
            <div class="theme-drawer__header">
              <button
                on:click="#cart-drawer/close"
                class="theme-drawer__close-button cart-drawer__close-button--empty"
                type="button"
                aria-label="{{ 'actions.close' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button>
            </div>
          {%- else -%}
            {% capture cart_badge_html %}
              <span
                class="theme-drawer__badge{% if cart.item_count == 0 %} visually-hidden{% endif %}"
                aria-hidden="true"
                {% if cart.item_count <= 99 %}
                  data-maintain-ratio
                {% endif %}
              >
                {{- cart.item_count -}}
              </span>
              {% if cart.item_count > 0 %}
                <span class="visually-hidden">
                  {{ 'accessibility.cart_count' | t }}: {{ cart.item_count }}
                </span>
              {% endif %}
            {% endcapture %}
            {% if settings.enable_custom_cart_drawer %}
              <div class="custom-cart-drawer__header">
                <button
                  on:click="#cart-drawer/close"
                  class="custom-cart-drawer__close-button"
                  type="button"
                  aria-label="{{ 'actions.close' | t }}"
                >
                  <span class="svg-wrapper">
                    {{- 'icon-close.svg' | inline_asset_content -}}
                  </span>
                </button>

                <div class="custom-cart-drawer__header-content">
                  <h2
                    id="cart-drawer-heading"
                    class="custom-cart-drawer__heading"
                  >
                    {{ 'content.cart_title' | t }}
                  </h2>

                  <span class="custom-cart-drawer__subheading">
                    {{ cart.item_count }}
                    {% if cart.item_count == 1 %}
                      product
                    {% else %}
                      products
                    {% endif %}
                  </span>
                </div>
              </div>
            {% else %}
              {% assign cart_drawer_title = 'content.cart_title' | t %}
              {% render 'theme-drawer-header',
                title: cart_drawer_title,
                drawer_id: 'cart-drawer',
                heading_id: 'cart-drawer-heading',
                title_append: cart_badge_html
              %}
            {% endif %}
          {%- endif -%}

          {% capture cart_items_children %}
            {%- if cart.empty? -%}
              {{ empty_cart_drawer_content }}
            {%- else -%}
              <scroll-hint
                class="cart-drawer__content"
                aria-label="{{ 'accessibility.cart' | t }}"
              >
                <scroll-hint class="cart-drawer__items">
                  {% render 'cart-products', context: 'drawer' %}
                </scroll-hint>

                <div
                  class="cart-drawer__summary"
                  style="{{ settings.custom_cart_checkout_wrapper_css }}"
                >
                  {% if settings.enable_custom_cart_drawer %}
                    <div
                      class="custom-cart-checkout"
                    >
                      <div class="custom-cart-checkout__date">
                        <label
                          class="custom-cart-checkout__date-label"
                          for="CustomCartDeliveryDate"
                        >
                          {{ settings.custom_cart_date_label }}
                        </label>

                        <div class="custom-cart-checkout__date-input-wrapper">
                          <input
                            id="CustomCartDeliveryDate"
                            class="custom-cart-checkout__date-input"
                            type="date"
                            aria-label="{{ settings.custom_cart_date_label | escape }}"
                          >

                          <span
                            class="custom-cart-checkout__date-icon"
                            aria-hidden="true"
                          >
                            {{ settings.custom_cart_date_icon | image_url: width: 100 | image_tag }}
                          </span>
                        </div>
                      </div>

                      <div class="custom-cart-checkout__estimated-total">
                        <span class="custom-cart-checkout__estimated-total-label">
                          {{ settings.custom_cart_estimated_total_label }}
                        </span>

                        <span class="custom-cart-checkout__estimated-total-value">
                          {{ cart.total_price | money }}
                        </span>
                      </div>

                      <button
                        type="submit"
                        id="checkout"
                        class="custom-cart-checkout__button"
                        name="checkout"
                        {% if cart == empty %}
                          disabled
                        {% endif %}
                        form="cart-form"
                      >
                        <span class="button-text">
                          {{ settings.custom_cart_checkout_label }}
                        </span>
                      </button>

                      <p
                        class="custom-cart-checkout__disclaimer"
                        style="margin: 0; width: 100%; text-align: center; font-size: 12px; font-weight: 500; color: #424242; line-height: 1.4;"
                      >
                        Taxes, discounts and shipping calculated at checkout
                      </p>
                    </div>
                  {% else %}
                    {% render 'cart-summary', section_id: 'cart-drawer-section' %}
                  {% endif %}
                </div>
              </scroll-hint>
            {%- endif -%}
          {% endcapture %}
          {% render 'cart-items-component',
            children: cart_items_children,
            is_drawer: true,
            section_id: 'cart-drawer-section'
          %}
        </div>
      </cart-drawer-component>
    </dialog>
  </theme-drawer>

  {% if render_wrapper %}
    </div>
  {% endif %}
{%- endif -%}

{% stylesheet %}
  cart-drawer-component {
    --cart-drawer-padding: var(--theme-drawer-padding);
    --font-paragraph--line-height: 1;
    display: contents;
  }

  .cart-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  .cart-drawer__inner > .cart-items-component {
    flex: 1;
    min-height: 0;
    height: auto;
  }

  .cart-drawer__content {
    display: flex;
    flex-direction: column;
    padding: 0;
    background-color: var(--color-background);
    flex-grow: 1;
    overflow-y: auto;
  }

  .cart-drawer__items {
    display: flex;
    flex-direction: column;
    padding-inline: var(--cart-drawer-padding);
    overflow-y: auto;
  }

  .cart-drawer__items .cart-items__table-row {
    padding-bottom: var(--gap-xl);
    border-bottom: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    margin-bottom: var(--gap-xl);
  }

  .cart-drawer__items .cart-items__table-row:has(+ .cart-items__nested-line) {
    border-bottom: none;
    margin-bottom: 0;
  }

  .cart-drawer__items .cart-items__table-row:last-child {
    border-bottom: none;
    padding-block-end: 0;
    margin-block-end: 0;
  }

  .cart-drawer__close-button--empty {
    margin-inline-start: auto;
  }

  .cart-drawer__summary {
    --cart-drawer-summary-padding: var(--padding-lg);

    position: sticky;
    bottom: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-xl);
    padding: var(--cart-drawer-summary-padding);
    margin-top: auto;
    background-color: var(--color-background);
    /* stylelint-disable-next-line color-named */
    mask-image: linear-gradient(to bottom, transparent, black var(--cart-drawer-summary-padding));

    @media screen and (min-width: 750px) {
      --cart-drawer-summary-padding: var(--padding-2xl);
    }
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__summary {
    position: static;
    mask-image: none;
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__items {
    overflow: unset;
  }

  .cart-actions summary {
    padding-inline: 0;
    padding-block: var(--padding-sm);
    line-height: 1.2;
    min-height: var(--minimum-touch-target);
  }

  .cart-drawer__summary .cart__summary-totals:not(:has(.cart__subtotal-container:empty)) {
    border-block-start: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block-start: var(--padding-2xl);
  }

  .cart-drawer__summary .cart-note {
    @media screen and (min-width: 750px) {
      margin-block-start: var(--margin-3xs);
    }
  }

  .cart-drawer--empty .cart-drawer__content {
    text-align: center;
    align-items: center;
    justify-content: center;
    min-height: auto;
  }

  .cart-drawer--empty .cart-drawer__items {
    padding-inline: 0;
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__content {
    text-align: center;
    align-items: center;
    justify-content: center;
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__items {
    padding-inline: 0;
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    html:active-view-transition-type(empty-cart-drawer) {
      .theme-drawer__close-button {
        view-transition-name: cart-drawer-close-button;
      }
    }
  }

  :active-view-transition {
    .cart-drawer__header,
    .cart-drawer__content {
      background: transparent;
    }
  }
{% endstylesheet %}

{% style %}
  {% if settings.enable_custom_cart_drawer %}
    /* =========================================================
      CUSTOM CART CHECKOUT
      ========================================================= */
    .custom-cart-checkout {
      {{ settings.custom_cart_checkout_wrapper_css }}

      display: flex;
      flex-direction: column;
      gap: var(--gap-md);
      width: 100%;
    }

    /* =========================================================
      DATE PICKER
      ========================================================= */
    .custom-cart-checkout__date {
      display: flex;
      flex-direction: column;
      gap: var(--gap-xs);
      width: 100%;
    }

    .custom-cart-checkout__date-label {
      font-size: {{ settings.custom_cart_date_font_size }}px;
      font-weight: {{ settings.custom_cart_date_font_weight }};
      color: {{ settings.custom_cart_date_text_color }};
    }

    .custom-cart-checkout__date-input-wrapper {
      position: relative;
      width: 100%;
    }

    .custom-cart-checkout__date-input {
      width: 100%;
      min-height: 44px;

      padding-inline-end: calc(
        {{ settings.custom_cart_date_icon_size }}px + var(--padding-md)
      );

      font-size: {{ settings.custom_cart_date_font_size }}px;
      font-weight: {{ settings.custom_cart_date_font_weight }};
      color: {{ settings.custom_cart_date_text_color }};

      appearance: none;
      -webkit-appearance: none;
    }

    .custom-cart-checkout__date-icon {
      position: absolute;
      top: 50%;
      right: var(--padding-md);

      width: {{ settings.custom_cart_date_icon_size }}px;
      height: {{ settings.custom_cart_date_icon_size }}px;

      transform: translateY(-50%);

      display: flex;
      align-items: center;
      justify-content: center;

      pointer-events: none;
    }

    .custom-cart-checkout__date-icon svg {
      width: 100%;
      height: 100%;
    }

    .custom-cart-checkout__date-input {
      {{ settings.custom_cart_date_css }}
    }
    .custom-cart-checkout__date-input::-webkit-calendar-picker-indicator {
      opacity: 0;
      display: none;
      -webkit-appearance: none;
    }
    .custom-cart-checkout__date-input::-webkit-calendar-picker-indicator {
      {{ settings.custom_cart_date_calendar_css }}
    }

    /* =========================================================
      ESTIMATED TOTAL
      ========================================================= */

    .custom-cart-checkout__estimated-total {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--gap-md);

      width: 100%;

      font-size: {{ settings.custom_cart_estimated_total_font_size }}px;
      font-weight: {{ settings.custom_cart_estimated_total_font_weight }};
      color: {{ settings.custom_cart_estimated_total_color }};
    }

    .custom-cart-checkout__estimated-total-label,
    .custom-cart-checkout__estimated-total-value {
      font-size: inherit;
      font-weight: inherit;
      color: inherit;
    }


    /* =========================================================
      CHECKOUT BUTTON
      ========================================================= */
    .custom-cart-checkout__button {
      width: 100%;

      background-color: {{ settings.custom_cart_checkout_background }};
      color: {{ settings.custom_cart_checkout_text_color }};

      font-weight: {{ settings.custom_cart_checkout_font_weight }};

      border: 0;
      cursor: pointer;

      {{ settings.custom_cart_checkout_css }}
    }

    .custom-cart-checkout__button:hover {
      {{ settings.custom_cart_checkout_hover_css }}
    }
  {% endif %}
{% endstyle %}

{% if settings.enable_custom_cart_drawer %}
  {% style %}
    .custom-cart-drawer__header {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      padding: var(--padding-lg) var(--cart-drawer-padding);
      border-bottom: 1px dashed #EFEFEF;
      margin-bottom: 5px;
    }

    .custom-cart-drawer__header-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    .custom-cart-drawer__heading {
      margin: 0;
      font-size: {{ settings.custom_cart_header_font_size }}px;
      color: {{ settings.custom_cart_header_color }};
      line-height: 1.2;
    }

    .custom-cart-drawer__subheading {
      margin-block-start: 4px;
      font-size: {{ settings.custom_cart_header_subheading_font_size }}px;
      color: {{ settings.custom_cart_header_subheading_color }};
      line-height: 1.2;
    }

    .custom-cart-drawer__close-button {
      position: absolute;
      inset-inline-end: var(--cart-drawer-padding);
      top: 50%;
      transform: translateY(-50%);
      display: flex;
      align-items: center;
      justify-content: center;
      width: var(--minimum-touch-target);
      height: var(--minimum-touch-target);
      padding: 0;
      margin: 0;
      border: none;
      box-shadow: none;
      background: transparent;
    }

    .custom-cart-drawer__close-button:hover {
      border: none;
      box-shadow: none;
      background: transparent;
    }

    .custom-cart-drawer__close-button .svg-wrapper,
    .custom-cart-drawer__close-button svg {
      width: 20px;
      height: 20px;
    }
  {% endstyle %}
{% endif %}
