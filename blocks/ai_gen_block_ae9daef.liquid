{% doc %}
  @prompt
    Genearte a carousel that allows you to go through the images of a product. The carousel must have thumbnails of the images underneath the main carousel content which can be used to jump to an image. The carousel should also have chevron indicators for moving through the content. Expose colors so I can adjust them via the GUI. Also, the product will be selected based off of a tag; so you need to expose the tag's target value so I can set it easily.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% assign target_product = null %}
{% for product in collections.all.products %}
  {% if product.tags contains block.settings.product_tag %}
    {% assign target_product = product %}
    {% break %}
  {% endif %}
{% endfor %}

{% style %}
  .ai-product-carousel-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-product-carousel-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-product-carousel-main-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.carousel_background }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-product-carousel-track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.3s ease;
  }

  {% comment %} .ai-product-carousel-slide-{{ ai_gen_id }} {
    min-width: 100%;
    flex-shrink: 0;
  }

  .ai-product-carousel-slide-{{ ai_gen_id }} img {
    width: auto;
    max-width: {{ block.settings.image_size }}%;
    height: auto;
    display: block;
    margin: 0 auto;
  } {% endcomment %}

  {% comment %} .ai-product-carousel-slide-{{ ai_gen_id }} {
    min-width: 100%;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.image_padding_y }}px {{ block.settings.image_padding_x }}px;
    box-sizing: border-box;
  }

  .ai-product-carousel-slide-{{ ai_gen_id }} img {
    width: auto;
    height: auto;
    max-width: {{ block.settings.image_width }}%;
    max-height: {{ block.settings.image_height }}px;
    display: block;
    object-fit: contain;
  } {% endcomment %}

  {% comment %} .ai-product-carousel-slide-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.image_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.image_padding_y }}px {{ block.settings.image_padding_x }}px;
    box-sizing: border-box;
  }

  .ai-product-carousel-slide-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  } {% endcomment %}

  .ai-product-carousel-slide-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.image_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.image_padding_y }}px {{ block.settings.image_padding_x }}px;
    box-sizing: border-box;
  }

  .ai-product-carousel-slide-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  {% if block.settings.show_all_images %}
    .ai-product-carousel-slide-{{ ai_gen_id }} {
      min-width: 100%;
      flex-shrink: 0;
    }
  {% endif %}

  .ai-product-carousel-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-product-carousel-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-product-carousel-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-product-carousel-chevron-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.chevron_background }};
    color: {{ block.settings.chevron_color }};
    border: none;
    width: {{ block.settings.chevron_size }}px;
    height: {{ block.settings.chevron_size }}px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
    transition: opacity 0.3s ease;
  }

  .ai-product-carousel-chevron-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-product-carousel-chevron-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-product-carousel-chevron-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
  }

  .ai-product-carousel-chevron-prev-{{ ai_gen_id }} {
    left: {{ block.settings.chevron_offset }}px;
  }

  .ai-product-carousel-chevron-next-{{ ai_gen_id }} {
    right: {{ block.settings.chevron_offset }}px;
  }

  .ai-product-carousel-thumbnails-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.thumbnail_gap }}px;
    margin-top: {{ block.settings.thumbnail_spacing }}px;
    overflow-x: auto;
    padding: 4px 0;
  }

  .ai-product-carousel-thumbnails-{{ ai_gen_id }}::-webkit-scrollbar {
    height: 4px;
  }

  .ai-product-carousel-thumbnails-{{ ai_gen_id }}::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 2px;
  }

  .ai-product-carousel-thumbnails-{{ ai_gen_id }}::-webkit-scrollbar-thumb {
    background: {{ block.settings.chevron_background }};
    border-radius: 2px;
  }

  .ai-product-carousel-thumbnail-{{ ai_gen_id }} {
    min-width: {{ block.settings.thumbnail_size }}px;
    width: {{ block.settings.thumbnail_size }}px;
    height: {{ block.settings.thumbnail_size }}px;
    border: 2px solid {{ block.settings.thumbnail_border_color }};
    border-radius: {{ block.settings.thumbnail_border_radius }}px;
    overflow: hidden;
    cursor: pointer;
    transition: border-color 0.3s ease, opacity 0.3s ease;
    opacity: 0.6;
  }

  .ai-product-carousel-thumbnail-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-product-carousel-thumbnail-{{ ai_gen_id }}.active {
    border-color: {{ block.settings.thumbnail_active_border }};
    opacity: 1;
  }

  .ai-product-carousel-thumbnail-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .ai-product-carousel-chevron-{{ ai_gen_id }} {
      width: {{ block.settings.chevron_size | times: 0.8 }}px;
      height: {{ block.settings.chevron_size | times: 0.8 }}px;
    }

    .ai-product-carousel-chevron-prev-{{ ai_gen_id }} {
      left: {{ block.settings.chevron_offset | times: 0.5 }}px;
    }

    .ai-product-carousel-chevron-next-{{ ai_gen_id }} {
      right: {{ block.settings.chevron_offset | times: 0.5 }}px;
    }

    .ai-product-carousel-thumbnail-{{ ai_gen_id }} {
      min-width: {{ block.settings.thumbnail_size | times: 0.8 }}px;
      width: {{ block.settings.thumbnail_size | times: 0.8 }}px;
      height: {{ block.settings.thumbnail_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<product-carousel-{{ ai_gen_id }} class="ai-product-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-carousel-container-{{ ai_gen_id }}">
    <div class="ai-product-carousel-main-{{ ai_gen_id }}">
      <div class="ai-product-carousel-track-{{ ai_gen_id }}">
        {% if target_product and target_product.images.size > 0 %}
          {% comment %} {% for image in target_product.images %}
            <div class="ai-product-carousel-slide-{{ ai_gen_id }}">
              <img
                src="{{ image | image_url: width: 1200 }}"
                alt="{{ image.alt | escape }}"
                loading="lazy"
                width="{{ image.width }}"
                height="{{ image.height }}"
              >
            </div>
          {% endfor %} {% endcomment %}
          {% for image in target_product.images %}
            {% if block.settings.show_all_images or forloop.first %}
              <div class="ai-product-carousel-slide-{{ ai_gen_id }}">
                <img
                  src="{{ image | image_url: width: 1200 }}"
                  alt="{{ image.alt | escape }}"
                  loading="lazy"
                  width="{{ image.width }}"
                  height="{{ image.height }}"
                >
              </div>
            {% endif %}
          {% endfor %}
        {% else %}
          <div class="ai-product-carousel-slide-{{ ai_gen_id }}">
            <div class="ai-product-carousel-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
              <div class="ai-product-carousel-empty-state-{{ ai_gen_id }}">
                {% if target_product == null %}
                  Next, set a product tag to display images
                {% else %}
                  This product has no images
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      </div>

      {% comment %} {% if target_product and target_product.images.size > 1 %} {% endcomment %}
      {% if target_product and block.settings.show_all_images and target_product.images.size > 1 %}
        <button
          class="ai-product-carousel-chevron-{{ ai_gen_id }} ai-product-carousel-chevron-prev-{{ ai_gen_id }}"
          aria-label="Previous image"
          data-direction="prev"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <button
          class="ai-product-carousel-chevron-{{ ai_gen_id }} ai-product-carousel-chevron-next-{{ ai_gen_id }}"
          aria-label="Next image"
          data-direction="next"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      {% endif %}
    </div>

    {% comment %} {% if target_product and target_product.images.size > 1 %} {% endcomment %}
    {% if target_product and block.settings.show_all_images and target_product.images.size > 1 %}
      <div class="ai-product-carousel-thumbnails-{{ ai_gen_id }}">
        {% comment %} {% for image in target_product.images %} {% endcomment %}
        {% for image in target_product.images %}
          {% if block.settings.show_all_images or forloop.first %}
            <button
              class="ai-product-carousel-thumbnail-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
              data-index="{{ forloop.index0 }}"
              aria-label="View image {{ forloop.index }}"
            >
              <img
                src="{{ image | image_url: width: 200 }}"
                alt="{{ image.alt | escape }}"
                loading="lazy"
                width="200"
                height="200"
              >
            </button>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</product-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.totalSlides = 0;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-product-carousel-track-{{ ai_gen_id }}');
        this.slides = this.querySelectorAll('.ai-product-carousel-slide-{{ ai_gen_id }}');
        this.thumbnails = this.querySelectorAll('.ai-product-carousel-thumbnail-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-product-carousel-chevron-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-product-carousel-chevron-next-{{ ai_gen_id }}');

        this.totalSlides = this.slides.length;

        if (this.totalSlides <= 1) return;

        this.setupEventListeners();
        this.updateCarousel();
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.navigate('prev'));
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.navigate('next'));
        }

        this.thumbnails.forEach((thumbnail) => {
          thumbnail.addEventListener('click', (e) => {
            const index = parseInt(e.currentTarget.dataset.index);
            this.goToSlide(index);
          });
        });

        let startX = 0;
        let currentX = 0;
        let isDragging = false;

        this.track.addEventListener('touchstart', (e) => {
          startX = e.touches[0].clientX;
          isDragging = true;
        });

        this.track.addEventListener('touchmove', (e) => {
          if (!isDragging) return;
          currentX = e.touches[0].clientX;
        });

        this.track.addEventListener('touchend', () => {
          if (!isDragging) return;
          isDragging = false;

          const diff = startX - currentX;
          if (Math.abs(diff) > 50) {
            if (diff > 0) {
              this.navigate('next');
            } else {
              this.navigate('prev');
            }
          }
        });
      }

      navigate(direction) {
        if (direction === 'next') {
          this.currentIndex = (this.currentIndex + 1) % this.totalSlides;
        } else {
          this.currentIndex = (this.currentIndex - 1 + this.totalSlides) % this.totalSlides;
        }
        this.updateCarousel();
      }

      goToSlide(index) {
        this.currentIndex = index;
        this.updateCarousel();
      }

      updateCarousel() {
        const offset = -this.currentIndex * 100;
        this.track.style.transform = `translateX(${offset}%)`;

        this.thumbnails.forEach((thumbnail, index) => {
          if (index === this.currentIndex) {
            thumbnail.classList.add('active');
          } else {
            thumbnail.classList.remove('active');
          }
        });

        if (this.prevButton) {
          this.prevButton.disabled = this.currentIndex === 0;
        }

        if (this.nextButton) {
          this.nextButton.disabled = this.currentIndex === this.totalSlides - 1;
        }
      }
    }

    customElements.define('product-carousel-{{ ai_gen_id }}', ProductCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Product image carousel",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Product selection"
    },
    {
      "type": "text",
      "id": "product_tag",
      "label": "Product tag",
      "info": "Enter a tag to find and display a product's images"
    },
    {
      "type": "checkbox",
      "id": "show_all_images",
      "label": "Show all product images",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "image_size",
      "label": "Image size",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image width",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Image height",
      "min": 100,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "image_padding_x",
      "label": "Horizontal padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "image_padding_y",
      "label": "Vertical padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Carousel colors"
    },
    {
      "type": "color",
      "id": "carousel_background",
      "label": "Background",
      "default": "#f4f4f4"
    },
    {
      "type": "header",
      "content": "Chevron navigation"
    },
    {
      "type": "range",
      "id": "chevron_size",
      "label": "Chevron size",
      "min": 30,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "chevron_offset",
      "label": "Chevron offset",
      "min": 5,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "color",
      "id": "chevron_background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "chevron_color",
      "label": "Icon color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Thumbnails"
    },
    {
      "type": "range",
      "id": "thumbnail_size",
      "label": "Thumbnail size",
      "min": 50,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "thumbnail_gap",
      "label": "Gap between thumbnails",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "thumbnail_spacing",
      "label": "Spacing from carousel",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "thumbnail_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "color",
      "id": "thumbnail_border_color",
      "label": "Border color",
      "default": "#e0e0e0"
    },
    {
      "type": "color",
      "id": "thumbnail_active_border",
      "label": "Active border color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Product image carousel"
    }
  ]
}
{% endschema %}