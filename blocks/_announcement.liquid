
{% render 'text-block-styles' %}

{%- assign block_settings = block.settings -%}
{%- assign plain_text = block_settings.text | strip_newlines | strip_html | strip -%}
{%- assign block_index = section.blocks | find_index: 'id', block.id -%}

{%- unless plain_text == '' -%}
  <slideshow-slide
    ref="slides[]"
    class="
      announcement-bar__slide
      text-block
      text-block--{{ block.id }}
      text-block--align-center
      text-block--full-width
      custom-typography
      {% if block_settings.font_size != "" %}custom-font-size{% endif %}
      {% if block_settings.weight != "" %}custom-font-weight{% endif %}
    "
    style="
      {% render 'typography-style', settings: block_settings, preset: 'custom' %}
      {% if block_settings.text_color != blank %}--color: {{ block_settings.text_color }}; --color-rgb: {{ block_settings.text_color.rgb }};{% endif %}
      --width: 100%;
      --text-align: center;
      --line-height: 1;
    "
    {{ block.shopify_attributes }}
    aria-hidden="{% if block_index == 0 %}false{% else %}true{% endif %}"
  >
    <p class="announcement-bar__text">
      {{ block.settings.text }}

      {% if block_settings.enable_link and block_settings.link != blank %}
        <a
          class="announcement-bar__inline-link announcement-bar__inline-link--{{ block.id }}"
          href="{{ block_settings.link }}"
          {% if block_settings.open_link_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
        >
          {{ block_settings.link_text }}
        </a>
      {% endif %}
    </p>
  </slideshow-slide>
{%- endunless -%}

{% stylesheet %}
  .announcement-bar__inline-link {
    color: var(--announcement-link-color);
    font-size: var(--announcement-link-font-size);
    font-weight: var(--announcement-link-font-weight);
    text-transform: var(--announcement-link-case);
    text-decoration-line: var(--announcement-link-decoration);
    text-decoration-color: var(--announcement-link-decoration-color);
    text-decoration-thickness: var(--announcement-link-decoration-thickness);
    text-underline-offset: var(--announcement-link-underline-offset);
    transition:
      color 0.2s ease,
      opacity 0.2s ease,
      font-weight 0.2s ease,
      text-decoration-color 0.2s ease,
      text-decoration-line 0.2s ease;
  }

  .announcement-bar__inline-link:hover {
    color: var(--announcement-link-hover-color);
    font-weight: var(--announcement-link-hover-font-weight);
    text-decoration-line: var(--announcement-link-hover-decoration);
    text-decoration-color: var(--announcement-link-hover-decoration-color);
    opacity: var(--announcement-link-hover-opacity);
  }
{% endstylesheet %}

{% style %}
  .announcement-bar__inline-link--{{ block.id }} {
    --announcement-link-color:
      {% if block_settings.link_color != blank %}
        {{ block_settings.link_color }}
      {% else %}
        currentColor
      {% endif %};

    --announcement-link-font-size:
      {% if block_settings.link_font_size > 0 %}
        {{ block_settings.link_font_size }}px
      {% else %}
        1em
      {% endif %};

    --announcement-link-font-weight:
      {% if block_settings.link_font_weight != blank %}
        {{ block_settings.link_font_weight }}
      {% else %}
        inherit
      {% endif %};

    --announcement-link-case:
      {% if block_settings.link_case == 'uppercase' %}
        uppercase
      {% elsif block_settings.link_case == 'lowercase' %}
        lowercase
      {% elsif block_settings.link_case == 'capitalize' %}
        capitalize
      {% else %}
        none
      {% endif %};

    --announcement-link-decoration:
      {% if block_settings.link_decoration == 'underline' %}
        underline
      {% elsif block_settings.link_decoration == 'overline' %}
        overline
      {% elsif block_settings.link_decoration == 'line-through' %}
        line-through
      {% else %}
        none
      {% endif %};

    --announcement-link-decoration-color:
      {% if block_settings.link_decoration_color != blank %}
        {{ block_settings.link_decoration_color }}
      {% else %}
        currentColor
      {% endif %};

    --announcement-link-decoration-thickness:
      {% if block_settings.link_decoration_thickness > 0 %}
        {{ block_settings.link_decoration_thickness }}px
      {% else %}
        auto
      {% endif %};

    --announcement-link-underline-offset:
      {% if block_settings.link_underline_offset > 0 %}
        {{ block_settings.link_underline_offset }}px
      {% else %}
        auto
      {% endif %};

    {% if block_settings.enable_link_hover %}
      --announcement-link-hover-color:
        {% if block_settings.link_hover_color != blank %}
          {{ block_settings.link_hover_color }}
        {% else %}
          var(--announcement-link-color)
        {% endif %};

      --announcement-link-hover-font-weight:
        {% if block_settings.link_hover_font_weight != blank %}
          {{ block_settings.link_hover_font_weight }}
        {% else %}
          var(--announcement-link-font-weight)
        {% endif %};

      --announcement-link-hover-decoration:
        {% if block_settings.link_hover_decoration == 'underline' %}
          underline
        {% elsif block_settings.link_hover_decoration == 'overline' %}
          overline
        {% elsif block_settings.link_hover_decoration == 'line-through' %}
          line-through
        {% else %}
          none
        {% endif %};

      --announcement-link-hover-decoration-color:
        {% if block_settings.link_hover_decoration_color != blank %}
          {{ block_settings.link_hover_decoration_color }}
        {% else %}
          var(--announcement-link-decoration-color)
        {% endif %};

      --announcement-link-hover-opacity:
        {{ block_settings.link_hover_opacity | divided_by: 100.0 }};
    {% else %}
      --announcement-link-hover-color: var(--announcement-link-color);
      --announcement-link-hover-font-weight: var(--announcement-link-font-weight);
      --announcement-link-hover-decoration: var(--announcement-link-decoration);
      --announcement-link-hover-decoration-color: var(--announcement-link-decoration-color);
      --announcement-link-hover-opacity: 1;
    {% endif %}
  }
{% endstyle %}

{% style %}
  {% if block_settings.enable_mobile_font_size_override %}
    @media screen and (max-width: 749px) {
      .text-block--{{ block.id }} {
        * {
          font-size: {{ block_settings.mobile_font_size }}px;
        }
      }
    }
  {% endif %}
{% endstyle %}

