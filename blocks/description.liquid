{% comment %} description.liquid {% endcomment %}

{% assign selected_product = closest.product %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% if selected_product and selected_product.description != blank %}
  {% style %}
    .ai-product-description-{{ ai_gen_id }} {
      margin-bottom: {{ block.settings.margin_bottom }}px;
      font-size: {{ block.settings.font_size }}px;
      line-height: {{ block.settings.line_height }};
      color: {{ block.settings.text_color }};
    }
  {% endstyle %}

  <div class="ai-product-description-{{ ai_gen_id }}">
    {{ selected_product.description }}
  </div>
{% endif %}

{% schema %}
{
  "name": "Description",
  "settings": [
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "line_height",
      "label": "Line height",
      "min": 1,
      "max": 2.5,
      "step": 0.1,
      "default": 1.6
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom margin",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Description"
    }
  ]
}
{% endschema %}