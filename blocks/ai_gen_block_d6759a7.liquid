<script>
  (function() {
    class HeaderNavigation{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.burger = this.querySelector('.ai-header-burger-{{ ai_gen_id }}');
        this.drawer = this.querySelector('.ai-header-mobile-drawer-{{ ai_gen_id }}');
        this.overlay = this.querySelector('.ai-header-drawer-overlay-{{ ai_gen_id }}');
        this.closeButton = this.querySelector('.ai-header-drawer-close-{{ ai_gen_id }}');
        this.dropdownItems = this.querySelectorAll('.ai-header-menu-item-dropdown-{{ ai_gen_id }}');
        this.mobileDropdownItems = this.querySelectorAll('.ai-header-mobile-menu-item-dropdown-{{ ai_gen_id }}');

        this.setupEventListeners();
        this.setupMobileActions();
      }

      setupEventListeners() {
        this.burger.addEventListener('click', () => this.openDrawer());
        this.closeButton.addEventListener('click', () => this.closeDrawer());
        this.overlay.addEventListener('click', () => this.closeDrawer());

        this.dropdownItems.forEach(item => {
          const link = item.querySelector('.ai-header-menu-link-{{ ai_gen_id }}');
          link.addEventListener('click', (e) => {
            e.preventDefault();
            this.toggleDropdown(item);
          });
        });

        this.mobileDropdownItems.forEach(item => {
          const link = item.querySelector('.ai-header-mobile-menu-link-{{ ai_gen_id }}');
          link.addEventListener('click', (e) => {
            e.preventDefault();
            this.toggleMobileDropdown(item);
          });
        });

        document.addEventListener('click', (e) => {
          if (!e.target.closest('.ai-header-menu-item-dropdown-{{ ai_gen_id }}')) {
            this.dropdownItems.forEach(item => {
              item.classList.remove('open');
              const link = item.querySelector('.ai-header-menu-link-{{ ai_gen_id }}');
              link.classList.remove('active');
            });
          }
        });
      }

      setupMobileActions() {
        const mobileActions = this.querySelectorAll('.ai-header-actions-{{ ai_gen_id }}')[1];
        if (window.innerWidth <= 990) {
          mobileActions.style.display = 'flex';
        }

        window.addEventListener('resize', () => {
          if (window.innerWidth <= 990) {
            mobileActions.style.display = 'flex';
          } else {
            mobileActions.style.display = 'none';
            this.closeDrawer();
          }
        });
      }

      openDrawer() {
        this.drawer.classList.add('open');
        this.overlay.classList.add('open');
        document.body.style.overflow = 'hidden';
      }

      closeDrawer() {
        this.drawer.classList.remove('open');
        this.overlay.classList.remove('open');
        document.body.style.overflow = '';
      }

      toggleDropdown(item) {
        const isOpen = item.classList.contains('open');
        
        this.dropdownItems.forEach(dropdownItem => {
          dropdownItem.classList.remove('open');
          const link = dropdownItem.querySelector('.ai-header-menu-link-{{ ai_gen_id }}');
          link.classList.remove('active');
        });

        if (!isOpen) {
          item.classList.add('open');
          const link = item.querySelector('.ai-header-menu-link-{{ ai_gen_id }}');
          link.classList.add('active');
        }
      }

      toggleMobileDropdown(item) {
        const isOpen = item.classList.contains('open');
        item.classList.toggle('open');
      }
    }

    customElements.define('header-navigation-{{ ai_gen_id }}', HeaderNavigation{{ ai_gen_id }});
  })();
</script>

