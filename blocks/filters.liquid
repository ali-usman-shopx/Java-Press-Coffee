{% if block_settings.enable_filter_sub_drawers %}
  <script>
    (() => {
      const initFilterSubDrawers = () => {
        const drawer = document.querySelector('#filters-drawer');

        if (!drawer || drawer.dataset.subdrawersInitialized === 'true') {
          return;
        }

        const mainView = drawer.querySelector('.facets-subdrawer__main');
        const panels = drawer.querySelectorAll('[data-filter-subdrawer-panel]');
        const triggers = drawer.querySelectorAll('[data-filter-subdrawer-trigger]');

        if (!mainView || !panels.length || !triggers.length) {
          return;
        }

        drawer.dataset.subdrawersInitialized = 'true';

        const showMainView = () => {
          panels.forEach((panel) => {
            panel.hidden = true;
          });

          mainView.hidden = false;
          delete drawer.dataset.subdrawerActive;
        };

        const showPanel = (index) => {
          const panel = drawer.querySelector(
            `[data-filter-subdrawer-panel][data-filter-index="${index}"]`
          );

          if (!panel) {
            return;
          }

          mainView.hidden = true;

          panels.forEach((item) => {
            item.hidden = item !== panel;
          });

          drawer.dataset.subdrawerActive = index;
        };

        triggers.forEach((trigger) => {
          trigger.addEventListener('click', () => {
            showPanel(trigger.dataset.filterIndex);
          });
        });

        drawer.addEventListener('click', (event) => {
          const backButton = event.target.closest('[data-filter-subdrawer-back]');

          if (backButton) {
            showMainView();
          }
        });

        drawer.addEventListener('close', showMainView);
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initFilterSubDrawers);
      } else {
        initFilterSubDrawers();
      }

      document.addEventListener('shopify:section:load', initFilterSubDrawers);
    })();
  </script>
{% endif %}

