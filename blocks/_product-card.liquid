      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 5
    },

    {
      "type": "range",
      "id": "image_padding",
      "label": "Image padding",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
