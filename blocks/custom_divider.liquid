{% comment %} custom_divider.liquid {% endcomment %}

{% style %}
  .divider-custom {
    width: 100%;
    height: {{ block.settings.thickness }}px;
    margin-top: {{ block.settings.margin_top }}px;
    margin-bottom: {{ block.settings.margin_bottom }}px;
    background-color: {{ block.settings.color }};
    border: none;
  }
{% endstyle %}

<hr class="divider-custom">

{% schema %}
{
  "name": "Divider",
  "settings": [
    {
      "type": "color",
      "id": "color",
      "label": "Color",
      "default": "#DFDFDF"
    },
    {
      "type": "range",
      "id": "thickness",
      "label": "Thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top margin",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom margin",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Divider"
    }
  ]
}
{% endschema %}