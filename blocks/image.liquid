

{% liquid
  assign block_settings = block.settings

  assign ratio = 1

  case block_settings.image_ratio
    when 'landscape'
      assign ratio = '16 / 9'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'adapt'
      assign ratio = block_settings.image.aspect_ratio
  endcase

  if ratio == 0 or ratio == null
    assign ratio = 1
  endif

  assign mobile_ratio = ratio

  if block_settings.enable_mobile_image and block_settings.mobile_image
    case block_settings.mobile_image_ratio
      when 'landscape'
        assign mobile_ratio = '16 / 9'
      when 'portrait'
        assign mobile_ratio = '4 / 5'
      when 'square'
        assign mobile_ratio = '1 / 1'
      when 'adapt'
        assign mobile_ratio = block_settings.mobile_image.aspect_ratio
    endcase

    if mobile_ratio == 0 or mobile_ratio == null
      assign mobile_ratio = 1
    endif
  endif
%}

{% capture class %}
  image-block image-block--{{ block.id }} image-block--height-{{ block_settings.height }} spacing-style size-style
{% endcapture %}

{% capture style %}
  --ratio: {{ ratio }};
  --mobile-ratio: {{ mobile_ratio }};

  {% render 'size-style', settings: block_settings %}
  {% render 'spacing-style', settings: block_settings %}
{% endcapture %}

{% capture image_border_style %}
  --ratio: {{ ratio }};
  {% render 'border-override', settings: block_settings %}
{% endcapture %}

{% capture mobile_image_border_style %}
  --ratio: {{ mobile_ratio }};
  {% render 'border-override', settings: block_settings, prefix: 'mobile_' %}
{% endcapture %}

{% liquid
  assign media_width_desktop = '100vw'
  assign media_width_mobile = '100vw'
  assign sizes = 'auto, (min-width: 750px) ' | append: media_width_desktop | append: ', ' | append: media_width_mobile
  assign widths = '240, 352, 832, 1200, 1600, 1920, 2560, 3840'
%}

{% capture image %}
  {%- if block_settings.image -%}

    <picture class="image-block__picture">

      {%- if block_settings.enable_mobile_image and block_settings.mobile_image -%}

        <source
          media="(max-width: 749px)"
          srcset="
            {{ block_settings.mobile_image | image_url: width: 240 }} 240w,
            {{ block_settings.mobile_image | image_url: width: 352 }} 352w,
            {{ block_settings.mobile_image | image_url: width: 832 }} 832w,
            {{ block_settings.mobile_image | image_url: width: 1200 }} 1200w,
            {{ block_settings.mobile_image | image_url: width: 1600 }} 1600w,
            {{ block_settings.mobile_image | image_url: width: 1920 }} 1920w
          "
          sizes="100vw"
        >

      {%- endif -%}

      {{
        block_settings.image
        | image_url: width: 3840
        | image_tag:
          width: block_settings.image.width,
          widths: widths,
          height: block_settings.image.height,
          class: 'image-block__image border-style',
          style: image_border_style,
          sizes: sizes
      }}

    </picture>

  {%- else -%}

    <div class="placeholder-image border-style size-style" style="{{ image_border_style }}">
      {{ 'detailed-apparel-1' | placeholder_svg_tag: 'image-block__placeholder' }}
    </div>

  {%- endif -%}
{% endcapture %}

{% if block_settings.link == blank %}
  <div
    class="{{ class }}"
    style="{{ style }}"
    {{ block.shopify_attributes }}
  >
    {{ image }}
  </div>
{% else %}
  <a
    href="{{ block_settings.link }}"
    class="{{ class }}"
    style="{{ style }}"
    {{ block.shopify_attributes }}
  >
    {{ image }}
  </a>
{% endif %}

{% stylesheet %}
  .image-block__placeholder {
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: center center;
    overflow: hidden;
    position: relative;
  }

  .placeholder-image {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
  }

  .image-block {
    display: flex;

    /* When the image is nested in a group, section, etc, respect the parent's horizontal alignment */
    justify-content: var(--horizontal-alignment, 'inline-start');
  }

  .image-block__picture {
    display: block;
    width: 100%;
  }

  .image-block--height-fill .image-block__image {
    height: 100%;
  }

  .image-block__image {
    display: block;
    width: 100%;
    object-fit: cover;
    aspect-ratio: var(--ratio);
  }
{% endstylesheet %}

{% style %}
  @media screen and (max-width: 749px) {
    .image-block--{{ block.id }} {
      {% if block_settings.enable_mobile_image and block_settings.mobile_image %}
        {% if block_settings.mobile_width == 'fit-content' %}
          width: fit-content;
        {% elsif block_settings.mobile_width == 'fill' %}
          width: 100%;
        {% elsif block_settings.mobile_width == 'custom' %}
          width: {{ block_settings.mobile_custom_width }}%;
        {% endif %}
      {% endif %}
    }

    .image-block--{{ block.id }} .image-block__picture {
      {% if block_settings.enable_mobile_image and block_settings.mobile_image %}
        {% if block_settings.mobile_width == 'fit-content' %}
          width: fit-content;
        {% elsif block_settings.mobile_width == 'fill' %}
          width: 100%;
        {% elsif block_settings.mobile_width == 'custom' %}
          width: {{ block_settings.mobile_custom_width }}%;
        {% endif %}
      {% endif %}
    }

    .image-block--{{ block.id }} .image-block__image {
      {% if block_settings.enable_mobile_image and block_settings.mobile_image %}
        aspect-ratio: var(--mobile-ratio);

        {% if block_settings.mobile_height == 'fill' %}
          height: 100%;
        {% elsif block_settings.mobile_height == 'fit' %}
          height: auto;
        {% endif %}
      {% endif %}
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "t:names.image",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_image",
      "label": "Enable separate mobile image",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "visible_if": "{{ block.settings.enable_mobile_image }}"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },

    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:settings.aspect_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "square",
          "label": "t:options.square"
        },
        {
          "value": "landscape",
          "label": "t:options.landscape"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:settings.height",
      "options": [
        {
          "value": "fit",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        }
      ],
      "default": "fit",
      "visible_if": "{{ block.settings.image_ratio == 'adapt' }}"
    },

    {
      "type": "header",
      "content": "Mobile image settings",
      "visible_if": "{{ block.settings.enable_mobile_image }}"
    },
    {
      "type": "select",
      "id": "mobile_image_ratio",
      "label": "Mobile aspect ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Auto"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ],
      "default": "adapt",
      "visible_if": "{{ block.settings.enable_mobile_image }}"
    },
    {
      "type": "select",
      "id": "mobile_width",
      "label": "Mobile width",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit content"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill",
      "visible_if": "{{ block.settings.enable_mobile_image }}"
    },
    {
      "type": "range",
      "id": "mobile_custom_width",
      "label": "Mobile custom width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.enable_mobile_image and block.settings.mobile_width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "Mobile height",
      "options": [
        {
          "value": "fit",
          "label": "Fit content"
        },
        {
          "value": "fill",
          "label": "Fill"
        }
      ],
      "default": "fit",
      "visible_if": "{{ block.settings.enable_mobile_image }}"
    },

    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },

    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },

    {
      "type": "header",
      "content": "Mobile borders",
      "visible_if": "{{ block.settings.enable_mobile_image }}"
    },
    {
      "type": "select",
      "id": "mobile_border",
      "label": "Mobile border style",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "solid",
          "label": "Solid"
        }
      ],
      "default": "none",
      "visible_if": "{{ block.settings.enable_mobile_image }}"
    },
    {
      "type": "range",
      "id": "mobile_border_width",
      "label": "Mobile border thickness",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.enable_mobile_image and block.settings.mobile_border != 'none' }}"
    },
    {
      "type": "range",
      "id": "mobile_border_opacity",
      "label": "Mobile border opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.enable_mobile_image and block.settings.mobile_border != 'none' }}"
    },
    {
      "type": "color",
      "id": "mobile_border_color",
      "label": "Mobile border color",
      "default": "#000000",
      "visible_if": "{{ block.settings.enable_mobile_image and block.settings.mobile_border != 'none' }}"
    },
    {
      "type": "range",
      "id": "mobile_border_radius",
      "label": "Mobile border radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.enable_mobile_image }}"
    },

    {
      "type": "header",
      "content": "Mobile padding",
      "visible_if": "{{ block.settings.enable_mobile_image }}"
    },
    {
      "type": "range",
      "id": "mobile_padding_block_start",
      "label": "Mobile top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.enable_mobile_image }}"
    },
    {
      "type": "range",
      "id": "mobile_padding_block_end",
      "label": "Mobile bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.enable_mobile_image }}"
    },
    {
      "type": "range",
      "id": "mobile_padding_inline_start",
      "label": "Mobile left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.enable_mobile_image }}"
    },
    {
      "type": "range",
      "id": "mobile_padding_inline_end",
      "label": "Mobile right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.enable_mobile_image }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.image",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}
