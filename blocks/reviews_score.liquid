{% comment %} review_score.liquid {% endcomment %}

{% assign selected_product = closest.product %}

{% liquid
  assign score_parts = block.settings.review_score_metafield | split: '.'
  assign count_parts = block.settings.review_count_metafield | split: '.'

  assign reviews_score_raw = selected_product.metafields[score_parts[0]][score_parts[1]].value
  assign reviews_count = selected_product.metafields[count_parts[0]][count_parts[1]].value

  assign reviews_score = reviews_score_raw | round
  
  if block.settings.enable_review_override
    assign reviews_score_raw = block.settings.manual_review_score
    assign reviews_count = block.settings.manual_review_count
    assign reviews_score = reviews_score_raw | round
  endif
%}

{% if reviews_score_raw != blank and reviews_count != blank %}
  {% style %}
    #Reviews-{{ block.id }} .reviews-score {
      display: flex;
      align-items: center;
      gap: {{ block.settings.content_gap }}px;
      margin-bottom: {{ block.settings.margin_bottom }}px;
    }

    #Reviews-{{ block.id }} .reviews-score__stars {
      display: flex;
      gap: {{ block.settings.star_gap }}px;
    }

    #Reviews-{{ block.id }} .reviews-score__star {
      width: {{ block.settings.star_size }}px;
      height: {{ block.settings.star_size }}px;
      display: block;
    }

    #Reviews-{{ block.id }} .reviews-score__star svg {
      width: 100%;
      height: 100%;
      fill: {{ block.settings.star_color }};
    }

    #Reviews-{{ block.id }} .reviews-score__star--empty svg {
      fill: {{ block.settings.empty_star_color }};
    }

    #Reviews-{{ block.id }} .reviews-score__score,
    #Reviews-{{ block.id }} .reviews-score__count {
      font-size: {{ block.settings.text_size }}px;
      color: {{ block.settings.text_color }};
      font-weight: {{ block.settings.text_weight }};
    }
  {% endstyle %}

  <div id="Reviews-{{ block.id }}">
    <div class="reviews-score">
      <div class="reviews-score__stars">
        {% for i in (1..5) %}
          {% if i <= reviews_score %}
            <span class="reviews-score__star">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            </span>
          {% else %}
            <span class="reviews-score__star reviews-score__star--empty">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            </span>
          {% endif %}
        {% endfor %}
      </div>

      <span class="reviews-score__score">
        {{ reviews_score_raw }}/5.00
      </span>

      <span class="reviews-score__count">
        ({{ reviews_count }})
      </span>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Reviews",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_review_override",
      "label": "Enable manual review override",
      "default": false,
      "info": "When enabled, the manual review score and review count below will be used instead of the product metafields."
    },
    {
      "type": "text",
      "id": "manual_review_score",
      "label": "Manual review score",
      "default": "5.00",
      "info": "Enter the review score to display, e.g. 4.8"
    },
    {
      "type": "text",
      "id": "manual_review_count",
      "label": "Manual review count",
      "default": "0",
      "info": "Enter the review count to display, e.g. 127. It will appear inside parentheses."
    },
    {
      "type": "text",
      "id": "review_score_metafield",
      "label": "Review score metafield",
      "default": "custom.review_score",
      "info": "Enter the full metafield ID, e.g. custom.review_score"
    },
    {
      "type": "text",
      "id": "review_count_metafield",
      "label": "Review count metafield",
      "default": "custom.reviews_count",
      "info": "Enter the full metafield ID, e.g. custom.reviews_count"
    },
    {
      "type": "range",
      "id": "star_size",
      "label": "Star size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "star_gap",
      "label": "Star spacing",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#DEB127"
    },
    {
      "type": "color",
      "id": "empty_star_color",
      "label": "Empty star color",
      "default": "#DFDFDF"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Text weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "700"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Content spacing",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom margin",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Reviews"
    }
  ]
}
{% endschema %}