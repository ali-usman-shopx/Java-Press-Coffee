{% comment %} accordion_product.liquid {% endcomment %}

{% assign selected_product = closest.product %}

{% liquid
  assign about_product = blank
  assign ingredients = blank

  if block.settings.enable_about_product
    assign about_parts = block.settings.about_product_metafield | split: '.'

    if about_parts.size == 2
      assign about_product = selected_product.metafields[about_parts[0]][about_parts[1]]
    endif
  endif

  if block.settings.enable_ingredients
    assign ingredients_parts = block.settings.ingredients_metafield | split: '.'

    if ingredients_parts.size == 2
      assign ingredients = selected_product.metafields[ingredients_parts[0]][ingredients_parts[1]]
    endif
  endif
%}

{% if selected_product and about_product != blank or selected_product and ingredients != blank %}
  {% style %}
    .accordion {
      width: 100%;
      margin-top: {{ block.settings.margin_top }}px;
      margin-bottom: {{ block.settings.margin_bottom }}px;
      display: flex;
      flex-direction: column;
      gap: {{ block.settings.item_gap }}px;
    }

    .accordion__item {
      background-color: {{ block.settings.background_color }};
      border-radius: {{ block.settings.border_radius }}px;
      overflow: hidden;
    }

    .accordion__toggle {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    .accordion__summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding: {{ block.settings.padding }}px;
      cursor: pointer;
      font-size: {{ block.settings.title_size }}px;
      font-weight: {{ block.settings.title_weight }};
      color: {{ block.settings.title_color }};
    }

    .accordion__icon {
      font-size: {{ block.settings.icon_size }}px;
      line-height: 1;
      font-weight: 400;
      color: {{ block.settings.icon_color }};
    }

    .accordion__icon::before {
      content: '+';
    }

    .accordion__toggle:checked ~ .accordion__summary .accordion__icon::before {
      content: '×';
    }

    .accordion__content-wrapper {
      max-height: 0;
      overflow: hidden;
      transition: max-height {{ block.settings.transition_duration }}ms {{ block.settings.transition_easing }};
    }

    .accordion__toggle:checked ~ .accordion__content-wrapper {
      max-height: 1000px;
    }

    .accordion__content {
      padding: 0 {{ block.settings.padding }}px {{ block.settings.padding }}px;
      font-size: {{ block.settings.content_size }}px;
      line-height: {{ block.settings.content_line_height }};
      color: {{ block.settings.content_color }};
    }
  {% endstyle %}

  <div class="accordion">

    {% if about_product != blank %}
      <div class="accordion__item">
        <input
          type="checkbox"
          id="accordion-about-{{ block.id }}"
          class="accordion__toggle"
          {% if block.settings.open_first_by_default %}
            checked
          {% endif %}
        >

        <label for="accordion-about-{{ block.id }}" class="accordion__summary">
          <span>{{ block.settings.about_product_title }}</span>
          <span class="accordion__icon"></span>
        </label>

        <div class="accordion__content-wrapper">
          <div class="accordion__content">
            {{ about_product.value }}
          </div>
        </div>
      </div>
    {% endif %}

    {% if ingredients != blank %}
      <div class="accordion__item">
        <input
          type="checkbox"
          id="accordion-ingredients-{{ block.id }}"
          class="accordion__toggle"
        >

        <label for="accordion-ingredients-{{ block.id }}" class="accordion__summary">
          <span>{{ block.settings.ingredients_title }}</span>
          <span class="accordion__icon"></span>
        </label>

        <div class="accordion__content-wrapper">
          <div class="accordion__content">
            {% if ingredients.type contains 'list' %}
              {{ ingredients.value | join: ', ' }}
            {% else %}
              {{ ingredients.value }}
            {% endif %}
          </div>
        </div>
      </div>
    {% endif %}

  </div>
{% endif %}

{% schema %}
{
  "name": "Accordion",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_about_product",
      "label": "Enable About Product",
      "default": true
    },
    {
      "type": "text",
      "id": "about_product_title",
      "label": "About Product title",
      "default": "About Product",
      "visible_if": "{{ block.settings.enable_about_product }}"
    },
    {
      "type": "text",
      "id": "about_product_metafield",
      "label": "About Product metafield",
      "default": "custom.about_product",
      "info": "Enter the full metafield ID, e.g. custom.about_product",
      "visible_if": "{{ block.settings.enable_about_product }}"
    },
    {
      "type": "checkbox",
      "id": "enable_ingredients",
      "label": "Enable Ingredients",
      "default": true
    },
    {
      "type": "text",
      "id": "ingredients_title",
      "label": "Ingredients title",
      "default": "Ingredients",
      "visible_if": "{{ block.settings.enable_ingredients }}"
    },
    {
      "type": "text",
      "id": "ingredients_metafield",
      "label": "Ingredients metafield",
      "default": "custom.ingredients",
      "info": "Enter the full metafield ID, e.g. custom.ingredients",
      "visible_if": "{{ block.settings.enable_ingredients }}"
    },
    {
      "type": "header",
      "content": "Accordion Behavior"
    },
    {
      "type": "checkbox",
      "id": "open_first_by_default",
      "label": "Open first item by default",
      "default": false
    },
    {
      "type": "range",
      "id": "transition_duration",
      "label": "Opening/closing duration",
      "min": 0,
      "max": 1000,
      "step": 50,
      "unit": "ms",
      "default": 300
    },
    {
      "type": "select",
      "id": "transition_easing",
      "label": "Opening/closing easing",
      "options": [
        {
          "value": "ease-in",
          "label": "Ease in"
        },
        {
          "value": "ease-out",
          "label": "Ease out"
        },
        {
          "value": "ease-in-out",
          "label": "Ease in/out"
        },
        {
          "value": "ease",
          "label": "Ease"
        },
        {
          "value": "linear",
          "label": "Linear"
        }
      ],
      "default": "ease"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F3F3F3"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "content_color",
      "label": "Content color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Item spacing",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top margin",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom margin",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "content_size",
      "label": "Content size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "content_line_height",
      "label": "Content line height",
      "min": 1,
      "max": 2.5,
      "step": 0.1,
      "default": 1.6
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Accordion"
    }
  ]
}
{% endschema %}