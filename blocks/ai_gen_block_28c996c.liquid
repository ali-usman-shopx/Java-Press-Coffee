{% doc %}
  @prompt
    A carousel of products with tabs along the top which allow me to cycle between the collection whose products are being loaded into the carousel. The tabs are best sellers (default), daily essentials, black, hard. Each product card should contain the product's primary image as the thumbnail and some basic data underneath like the title, review stars (and count), price and compare at price, and a button to Add To Cart. The image should be wrapped in a container which will have a gray background and rounded corners and be slightly padded. That div will also contain an absolutely position image (the stamp). The card itself should have a transparent background.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-carousel-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-product-carousel__tabs-{{ ai_gen_id }} {
    display: flex;
    {% comment %} gap: 12px; {% endcomment %}
    margin-bottom: 32px;
    flex-wrap: wrap;
    border-bottom: 1px solid black;
    {% comment %} justify-content: center; {% endcomment %}
    {% comment %} padding-left: {{ block.settings.tab_padding }}; {% endcomment %}
    {% comment %} padding-right: {{ block.settings.tab_padding }}; {% endcomment %}
    {% comment %} justify-content: space-around; {% endcomment %}
    justify-content: center;
    gap: {{ block.settings.tabs_gap_desktop }};
    flex-wrap: nowrap;
    overflow-x: auto;
    
    {% comment %} /* Establish a safe rendering context for bottom lines */ {% endcomment %}
    box-shadow: inset 0 -1px 0 0 #EBEAE7; 
    border-bottom: none;
    {% comment %} ^ /* Replaced with inner shadow box */ {% endcomment %}
  }

  {% comment %} /* Optional: Hides scrollbar on Chrome/Safari for cleaner navigation look */ {% endcomment %}
  .ai-product-carousel__tabs-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
  }

  .ai-product-carousel__tab-{{ ai_gen_id }} {
    padding: 12px 24px;
    padding-left: {{ block.settings.tab_padding }};
    padding-right: {{ block.settings.tab_padding }};
    {% comment %} background-color: {{ block.settings.tab_background }}; {% endcomment %}
    background-color: transparent;
    color: {{ block.settings.tab_text_color }};
    {% comment %} border: {{ block.settings.tab_border_width }}px solid {{ block.settings.tab_border_color }}; {% endcomment %}
    border: none;
    border-bottom: 1px solid transparent;
    {% comment %} border-radius: {{ block.settings.tab_border_radius }}px; {% endcomment %}
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 14px;
    font-weight: 500;
    {% comment %} margin-bottom: -1px; {% endcomment %}
    {% comment %} ^ for border collapse {% endcomment %}
    flex-shrink: 0;
    {% comment %} ^ /* CRITICAL FIX: Stops text fields from squishing down */ {% endcomment %}
    margin-bottom: 0px;
    {% comment %} Remove the overlap workaround; boxshadow handles alignment {% endcomment %}
  }

  .ai-product-carousel__tab-{{ ai_gen_id }}:hover {
    {% comment %} background-color: {{ block.settings.tab_hover_background }};
    color: {{ block.settings.tab_hover_text_color }}; {% endcomment %}
    border-bottom: 1px solid #EF4444;
  }

  .ai-product-carousel__tab-{{ ai_gen_id }}.active {
    {% comment %} background-color: {{ block.settings.tab_active_background }};
    color: {{ block.settings.tab_active_text_color }};
    border-color: {{ block.settings.tab_active_border_color }}; {% endcomment %}
    border-bottom: 1px solid #EF4444;
  }

  .ai-product-carousel__content-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-product-carousel__collection-{{ ai_gen_id }} {
    display: none;
  }

  .ai-product-carousel__collection-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-product-carousel__wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    padding-bottom: 5px;
  }

  .ai-product-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    transition: transform 0.4s ease;
  }

  .ai-product-carousel__card-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.products_per_row }} - 1) * {{ block.settings.card_gap }}px) / {{ block.settings.products_per_row }});
    background-color: transparent;
  }

  .ai-product-carousel__image-container-{{ ai_gen_id }} {
    position: relative;
    background-color: {{ block.settings.image_background }};
    {% comment %} border-radius: {{ block.settings.image_border_radius }}px; {% endcomment %}
    border-radius: 5px;
    padding: {{ block.settings.image_padding }}px;
    margin-bottom: 16px;
    overflow: hidden;
  }

  .ai-product-carousel__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .ai-product-carousel__stamp-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.stamp_position_top }}px;
    right: {{ block.settings.stamp_position_right }}px;
    width: {{ block.settings.stamp_size }}px;
    height: {{ block.settings.stamp_size }}px;
    z-index: 2;
  }

  .ai-product-carousel__stamp-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-product-carousel__info-{{ ai_gen_id }} {
    padding: 0 8px;
  }

  .ai-product-carousel__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: 600;
    margin: 0 0 8px;
    color: {{ block.settings.text_color }};
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .ai-product-carousel__reviews-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
  }

  .ai-product-carousel__stars-{{ ai_gen_id }} {
    display: flex;
    gap: 2px;
    {% comment %} color: {{ block.settings.star_color }}; {% endcomment %}
    color: #EF4444;
  }

  .ai-product-carousel__star-{{ ai_gen_id }} {
    width: 14px;
    height: 14px;
  }

  .ai-product-carousel__review-count-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.review_count_color }};
  }

  .ai-product-carousel__price-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .ai-product-carousel__current-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_font_size }}px;
    font-weight: 600;
    color: {{ block.settings.price_color }};
  }

  .ai-product-carousel__compare-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.compare_price_font_size }}px;
    color: {{ block.settings.compare_price_color }};
    text-decoration: line-through;
  }

  .ai-product-carousel__add-to-cart-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 20px;
    {% comment %} background-color: {{ block.settings.button_background }}; {% endcomment %}
    background-color: #EF4444;
    color: {{ block.settings.button_text_color }};
    border: none;
    {% comment %} border-radius: {{ block.settings.button_border_radius }}px; {% endcomment %}
    border-radius: 5px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-product-carousel__add-to-cart-{{ ai_gen_id }}:hover {
    {% comment %} background-color: {{ block.settings.button_hover_background }}; {% endcomment %}
    opacity: 0.8;
  }

  .ai-product-carousel__nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    {% comment %} background-color: {{ block.settings.nav_background }}; {% endcomment %}
    background-color: black;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: background-color 0.3s ease;
  }

  .ai-product-carousel__nav-{{ ai_gen_id }}:hover {
    {% comment %} background-color: {{ block.settings.nav_hover_background }}; {% endcomment %}
    opacity: 0.8;
  }

  .ai-product-carousel__nav-{{ ai_gen_id }}--prev {
    left: 1px;
  }

  .ai-product-carousel__nav-{{ ai_gen_id }}--next {
    right: 1px;
  }

  .ai-product-carousel__nav-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    {% comment %} color: {{ block.settings.nav_icon_color }}; {% endcomment %}
    color: white;
  }

  {% comment %} Indicators {% endcomment %}
  .ai-product-carousel__dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
  }

  .ai-product-carousel__dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background-color: #D1D1D1;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-product-carousel__dot-{{ ai_gen_id }}.active {
    background-color: black;
    transform: scale(1.2);
  }

  .ai-product-carousel__empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: {{ block.settings.text_color }};
  }

  .ai-product-carousel__empty-title-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .ai-product-carousel__empty-text-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.review_count_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-product-carousel__card-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.products_per_row_mobile }} - 1) * {{ block.settings.card_gap }}px) / {{ block.settings.products_per_row_mobile }});
    }

    .ai-product-carousel__nav-{{ ai_gen_id }}--prev {
      left: 0;
    }

    .ai-product-carousel__nav-{{ ai_gen_id }}--next {
      right: 0;
    }

    .ai-product-carousel__tabs-{{ ai_gen_id }} {
      gap: {{ block.settings.tabs_gap_mobile }};
      justify-content: start;
    }
  }
{% endstyle %}

<product-carousel-{{ ai_gen_id }} class="ai-product-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-carousel__tabs-{{ ai_gen_id }}">
    {% if block.settings.collection_1 != blank %}
      <button
        class="ai-product-carousel__tab-{{ ai_gen_id }} active"
        data-collection="1"
      >
        {{ block.settings.tab_1_label }}
      </button>
    {% endif %}
    {% if block.settings.collection_2 != blank %}
      <button
        class="ai-product-carousel__tab-{{ ai_gen_id }}"
        data-collection="2"
      >
        {{ block.settings.tab_2_label }}
      </button>
    {% endif %}
    {% if block.settings.collection_3 != blank %}
      <button
        class="ai-product-carousel__tab-{{ ai_gen_id }}"
        data-collection="3"
      >
        {{ block.settings.tab_3_label }}
      </button>
    {% endif %}
    {% if block.settings.collection_4 != blank %}
      <button
        class="ai-product-carousel__tab-{{ ai_gen_id }}"
        data-collection="4"
      >
        {{ block.settings.tab_4_label }}
      </button>
    {% endif %}
  </div>

  <div class="ai-product-carousel__content-{{ ai_gen_id }}">
    {% for i in (1..4) %}
      {% assign collection_key = 'collection_' | append: i %}
      {% assign collection = block.settings[collection_key] %}
      
      {% if collection != blank %}
        <div
          class="ai-product-carousel__collection-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}"
          data-collection-id="{{ i }}"
        >
          {% if collection.products.size > 0 %}
            <div class="ai-product-carousel__wrapper-{{ ai_gen_id }}">
              <div class="ai-product-carousel__track-{{ ai_gen_id }}" data-track="{{ i }}">
                {% for product in collection.products limit: block.settings.max_products %}
                  <div class="ai-product-carousel__card-{{ ai_gen_id }}">
                    <div class="ai-product-carousel__image-container-{{ ai_gen_id }}">
                      {% if block.settings.stamp_image != blank %}
                        <div class="ai-product-carousel__stamp-{{ ai_gen_id }}">
                          <img
                            src="{{ block.settings.stamp_image | image_url: width: 200 }}"
                            alt="{{ block.settings.stamp_image.alt | escape }}"
                            loading="lazy"
                            width="200"
                            height="auto"
                          >
                        </div>
                      {% endif %}
                      
                      <a href="{{ product.url }}">
                        {% if product.featured_image %}
                          <img
                            src="{{ product.featured_image | image_url: width: 600 }}"
                            alt="{{ product.featured_image.alt | escape }}"
                            class="ai-product-carousel__image-{{ ai_gen_id }}"
                            loading="lazy"
                            width="600"
                            height="600"
                          >
                        {% else %}
                          <div class="ai-product-carousel__image-placeholder-{{ ai_gen_id }}">
                            {{ 'product-1' | placeholder_svg_tag }}
                          </div>
                        {% endif %}
                      </a>
                    </div>

                    <div class="ai-product-carousel__info-{{ ai_gen_id }}">
                      <h3 class="ai-product-carousel__title-{{ ai_gen_id }}">
                        <a href="{{ product.url }}">{{ product.title }}</a>
                      </h3>

                      {% comment %} {% if block.settings.show_reviews %}
                        <div class="ai-product-carousel__reviews-{{ ai_gen_id }}">
                          <div class="ai-product-carousel__stars-{{ ai_gen_id }}">
                            {% for star in (0..4) %}
                              <svg class="ai-product-carousel__star-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                              </svg>
                            {% endfor %}
                          </div>
                          {% comment %} <span class="ai-product-carousel__review-count-{{ ai_gen_id }}">({{ block.settings.default_review_count }})</span> {% endcomment %}
                          <span class="ai-product-carousel__review-count-{{ ai_gen_id }}">({{ product.metafields.custom.reviews_count }})</span>
                          </div>
                      {% endif %} {% endcomment %}

                      {% if block.settings.show_reviews %}
                        {%- comment -%} Establish the score with a default fallback of 5 {%- endcomment -%}
                        {%- assign raw_score = product.metafields.custom.reviews_score.value | default: 5 -%}
                        {%- assign total_stars = raw_score | plus: 0 | round -%}

                        {%- comment -%} Establish the count with a default fallback of 0 {%- endcomment -%}
                        {%- assign review_count = product.metafields.custom.reviews_count.value | default: 0 -%}

                        <div class="ai-product-carousel__reviews-{{ ai_gen_id }}">
                          <div class="ai-product-carousel__stars-{{ ai_gen_id }}">
                            {%- comment -%} Loop from 1 to the rounded total_stars number {%- endcomment -%}
                            {% for i in (1..total_stars) %}
                              <svg class="ai-product-carousel__star-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                              </svg>
                            {% endfor %}
                          </div>
                          
                          <span class="ai-product-carousel__review-count-{{ ai_gen_id }}">({{ review_count }})</span>
                        </div>
                      {% endif %}

                      <div class="ai-product-carousel__price-{{ ai_gen_id }}">
                        <span class="ai-product-carousel__current-price-{{ ai_gen_id }}">
                          {{ product.price | money }}
                        </span>
                        {% if product.compare_at_price > product.price %}
                          <span class="ai-product-carousel__compare-price-{{ ai_gen_id }}">
                            {{ product.compare_at_price | money }}
                          </span>
                        {% endif %}
                      </div>

                      <button
                        class="ai-product-carousel__add-to-cart-{{ ai_gen_id }}"
                        data-product-id="{{ product.id }}"
                        data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                      >
                        {{ block.settings.button_text }}
                      </button>
                    </div>
                  </div>
                {% endfor %}
              </div>

              {% comment %} {% if collection.products.size > block.settings.products_per_row %}
                <button
                  class="ai-product-carousel__nav-{{ ai_gen_id }} ai-product-carousel__nav-{{ ai_gen_id }}--prev"
                  data-nav="prev"
                  data-collection="{{ i }}"
                  aria-label="Previous products"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="15 18 9 12 15 6"></polyline>
                  </svg>
                </button>
                <button
                  class="ai-product-carousel__nav-{{ ai_gen_id }} ai-product-carousel__nav-{{ ai_gen_id }}--next"
                  data-nav="next"
                  data-collection="{{ i }}"
                  aria-label="Next products"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </button>
              {% endif %} {% endcomment %}
              {% comment %} {% if collection.products.size > block.settings.products_per_row %} {% endcomment %}
              {% if collection.products.size > 1 %}
                <button
                  class="ai-product-carousel__nav-{{ ai_gen_id }} ai-product-carousel__nav-{{ ai_gen_id }}--prev"
                  data-nav="prev"
                  data-collection="{{ i }}"
                  aria-label="Previous products"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="15 18 9 12 15 6"></polyline>
                  </svg>
                </button>

                <button
                  class="ai-product-carousel__nav-{{ ai_gen_id }} ai-product-carousel__nav-{{ ai_gen_id }}--next"
                  data-nav="next"
                  data-collection="{{ i }}"
                  aria-label="Next products"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </button>
              {% endif %}
              <div
                class="ai-product-carousel__dots-{{ ai_gen_id }}"
                data-dots="{{ i }}"
                aria-label="Carousel pagination"
              ></div>
            </div>
          {% else %}
            <div class="ai-product-carousel__empty-{{ ai_gen_id }}">
              <div class="ai-product-carousel__empty-title-{{ ai_gen_id }}">No products found</div>
              <div class="ai-product-carousel__empty-text-{{ ai_gen_id }}">Add products to this collection to display them here</div>
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</product-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = {};
        this.productsPerRow = {{ block.settings.products_per_row }};
        this.productsPerRowMobile = {{ block.settings.products_per_row_mobile }};
      }

      connectedCallback() {
        this.tabs = this.querySelectorAll('.ai-product-carousel__tab-{{ ai_gen_id }}');
        this.collections = this.querySelectorAll('.ai-product-carousel__collection-{{ ai_gen_id }}');
        this.navButtons = this.querySelectorAll('.ai-product-carousel__nav-{{ ai_gen_id }}');
        this.dotContainers = this.querySelectorAll('.ai-product-carousel__dots-{{ ai_gen_id }}');
        this.addToCartButtons = this.querySelectorAll('.ai-product-carousel__add-to-cart-{{ ai_gen_id }}');

        this.collections.forEach((collection) => {
          const collectionId = collection.dataset.collectionId;
          this.currentSlide[collectionId] = 0;
        });

        this.setupTabs();
        this.setupNavigation();
        this.setupDots();
        this.setupAddToCart();
        this.setupResizeHandler();
      }

      setupTabs() {
        this.tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const collectionId = tab.dataset.collection;

            this.tabs.forEach((t) => t.classList.remove('active'));
            tab.classList.add('active');

            this.collections.forEach((c) => c.classList.remove('active'));
            const targetCollection = this.querySelector(`[data-collection-id="${collectionId}"]`);
            if (targetCollection) {
              targetCollection.classList.add('active');
            }
          });
        });
      }

      {% comment %} setupNavigation() {
        this.navButtons.forEach((button) => {
          button.addEventListener('click', () => {
            const direction = button.dataset.nav;
            const collectionId = button.dataset.collection;
            const track = this.querySelector(`[data-track="${collectionId}"]`);
            const cards = track.querySelectorAll('.ai-product-carousel__card-{{ ai_gen_id }}');
            
            const isMobile = window.innerWidth < 750;
            const perRow = isMobile ? this.productsPerRowMobile : this.productsPerRow;
            const maxSlide = Math.max(0, cards.length - perRow);

            if (direction === 'next') {
              this.currentSlide[collectionId] = Math.min(this.currentSlide[collectionId] + 1, maxSlide);
            } else {
              this.currentSlide[collectionId] = Math.max(this.currentSlide[collectionId] - 1, 0);
            }

            const cardWidth = cards[0].offsetWidth;
            const gap = {{ block.settings.card_gap }};
            const offset = this.currentSlide[collectionId] * (cardWidth + gap);
            track.style.transform = `translateX(-${offset}px)`;
          });
        });
      } {% endcomment %}
      setupNavigation() {
        this.navButtons.forEach((button) => {
          button.addEventListener('click', () => {
            const direction = button.dataset.nav;
            const collectionId = button.dataset.collection;

            const currentSlide = this.currentSlide[collectionId];

            if (direction === 'next') {
              this.goToSlide(collectionId, currentSlide + 1);
            } else {
              this.goToSlide(collectionId, currentSlide - 1);
            }
          });
        });
      }

      {% comment %} setupDots() {
        this.dotContainers.forEach((container) => {
          const collectionId = container.dataset.dots;
          const track = this.querySelector(`[data-track="${collectionId}"]`);
          const cards = track.querySelectorAll('.ai-product-carousel__card-{{ ai_gen_id }}');

          const isMobile = window.innerWidth < 750;
          const perRow = isMobile ? this.productsPerRowMobile : this.productsPerRow;
          const maxSlide = Math.max(0, cards.length - perRow);

          container.innerHTML = '';

          for (let i = 0; i <= maxSlide; i++) {
            const dot = document.createElement('button');

            dot.className = 'ai-product-carousel__dot-{{ ai_gen_id }}';
            dot.dataset.slide = i;
            dot.setAttribute('aria-label', `Go to slide ${i + 1}`);

            if (i === 0) {
              dot.classList.add('active');
            }

            dot.addEventListener('click', () => {
              this.goToSlide(collectionId, i);
            });

            container.appendChild(dot);
          }
        });
      } {% endcomment %}

      setupDots() {
        this.dotContainers.forEach((container) => {
          const collectionId = container.dataset.dots;
          const track = this.querySelector(`[data-track="${collectionId}"]`);
          const cards = track.querySelectorAll('.ai-product-carousel__card-{{ ai_gen_id }}');

          if (!cards.length) return;

          const isMobile = window.innerWidth < 750;

          // Desktop: indicators represent carousel positions.
          // Mobile: one indicator represents each card.
          const dotCount = isMobile
            ? cards.length
            : Math.max(1, cards.length - this.productsPerRow + 1);

          container.innerHTML = '';

          for (let i = 0; i < dotCount; i++) {
            const dot = document.createElement('button');

            dot.className = 'ai-product-carousel__dot-{{ ai_gen_id }}';
            dot.dataset.slide = i;
            dot.setAttribute('aria-label', `Go to card ${i + 1}`);

            if (i === this.currentSlide[collectionId]) {
              dot.classList.add('active');
            }

            dot.addEventListener('click', () => {
              this.goToSlide(collectionId, i);
            });

            container.appendChild(dot);
          }
        });
      }

      setupAddToCart() {
        this.addToCartButtons.forEach((button) => {
          button.addEventListener('click', () => {
            const variantId = button.dataset.variantId;
            const originalText = button.textContent;

            button.textContent = 'Adding...';
            button.disabled = true;

            fetch('/cart/add.js', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({
                id: variantId,
                quantity: 1
              })
            })
            .then(response => response.json())
            .then(data => {
              button.textContent = 'Added!';
              setTimeout(() => {
                button.textContent = originalText;
                button.disabled = false;
              }, 2000);

              if (window.theme && window.theme.cart) {
                window.theme.cart.refresh();
              }
            })
            .catch(error => {
              console.error('Error:', error);
              button.textContent = 'Error';
              setTimeout(() => {
                button.textContent = originalText;
                button.disabled = false;
              }, 2000);
            });
          });
        });
      }

      {% comment %} goToSlide(collectionId, slide) {
        const track = this.querySelector(`[data-track="${collectionId}"]`);
        const cards = track.querySelectorAll('.ai-product-carousel__card-{{ ai_gen_id }}');

        if (!cards.length) return;

        const isMobile = window.innerWidth < 750;
        const perRow = isMobile ? this.productsPerRowMobile : this.productsPerRow;
        const maxSlide = Math.max(0, cards.length - perRow);

        this.currentSlide[collectionId] = Math.max(0, Math.min(slide, maxSlide));

        const cardWidth = cards[0].offsetWidth;
        const gap = {{ block.settings.card_gap }};
        const offset = this.currentSlide[collectionId] * (cardWidth + gap);

        track.style.transform = `translateX(-${offset}px)`;

        this.updateDots(collectionId);
      } {% endcomment %}

      goToSlide(collectionId, slide) {
        const track = this.querySelector(`[data-track="${collectionId}"]`);
        const cards = track.querySelectorAll('.ai-product-carousel__card-{{ ai_gen_id }}');

        if (!cards.length) return;

        const isMobile = window.innerWidth < 750;
        const perRow = isMobile ? this.productsPerRowMobile : this.productsPerRow;

        const cardWidth = cards[0].offsetWidth;
        const gap = {{ block.settings.card_gap }};
        const step = cardWidth + gap;

        let maxSlide;

        if (isMobile) {
          // Mobile indicators represent individual cards.
          maxSlide = cards.length - 1;
        } else {
          // Desktop indicators represent valid carousel positions.
          maxSlide = Math.max(0, cards.length - perRow);
        }

        const requestedSlide = Math.max(0, Math.min(slide, maxSlide));

        /*
        * Prevent the track from translating farther than its
        * actual scrollable width.
        *
        * This is especially important on mobile because there
        * are more indicators than there are complete 2-card views.
        */
        const wrapper = track.parentElement;
        const maxOffset = Math.max(
          0,
          track.scrollWidth - wrapper.clientWidth
        );

        const offset = Math.min(
          requestedSlide * step,
          maxOffset
        );

        this.currentSlide[collectionId] = requestedSlide;

        track.style.transform = `translateX(-${offset}px)`;

        this.updateDots(collectionId);
      }

      updateDots(collectionId) {
        const container = this.querySelector(`[data-dots="${collectionId}"]`);

        if (!container) return;

        const dots = container.querySelectorAll('.ai-product-carousel__dot-{{ ai_gen_id }}');

        dots.forEach((dot, index) => {
          dot.classList.toggle(
            'active',
            index === this.currentSlide[collectionId]
          );
        });
      }

      setupResizeHandler() {
        let resizeTimeout;

        window.addEventListener('resize', () => {
          clearTimeout(resizeTimeout);

          resizeTimeout = setTimeout(() => {
            const currentSlides = { ...this.currentSlide };

            this.setupDots();

            Object.keys(currentSlides).forEach((collectionId) => {
              this.goToSlide(collectionId, currentSlides[collectionId]);
            });
          }, 150);
        });
      }
    }

    customElements.define('product-carousel-{{ ai_gen_id }}', ProductCarousel{{ ai_gen_id }});
  })();
</script>

