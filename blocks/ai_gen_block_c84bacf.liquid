{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .custom-header-{{ ai_gen_id }} {
    --header-primary: {{ block.settings.primary_text_color }};
    --header-secondary: {{ block.settings.secondary_text_color }};
    --header-accent: {{ block.settings.accent_color }};
    --header-background: {{ block.settings.background_color }};
    --header-nav-bg: {{ block.settings.nav_background_color }};
    --header-contrast: {{ block.settings.contrast_text_color }};
    --header-menu-border: {{ block.settings.background_color | color_modify: 'alpha', 0.5 }};

    position: relative;
    z-index: 100;
    width: 100%;
    background: var(--header-nav-bg);
    color: var(--header-primary);
    display: block;
  }

  .custom-header-{{ ai_gen_id }}__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: {{ block.settings.max_width }}px;
    min-height: {{ block.settings.header_height }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.horizontal_padding }}px;
  }

  .custom-header-{{ ai_gen_id }}__brand {
    color: var(--header-primary);
    font-family: {{ block.settings.brand_font.family }}, {{ block.settings.brand_font.fallback_families }};
    font-size: {{ block.settings.brand_font_size }}px;
    font-weight: {{ block.settings.brand_font_weight }};
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .custom-header-{{ ai_gen_id }}__right {
    display: flex;
    align-items: center;
    gap: {{ block.settings.navigation_gap }}px;
  }

  .custom-header-{{ ai_gen_id }}__navigation {
    display: flex;
    align-items: center;
    gap: {{ block.settings.navigation_gap }}px;
    height: 100%;
  }

  .custom-header-{{ ai_gen_id }}__nav-item {
    position: relative;
    display: flex;
    align-items: center;
    height: 100%;
  }

  .custom-header-{{ ai_gen_id }}__nav-link {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 100%;
    padding: 10px 0;
    color: var(--header-secondary);
    font-size: {{ block.settings.navigation_font_size }}px;
    font-weight: {{ block.settings.navigation_font_weight }};
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .custom-header-{{ ai_gen_id }}__nav-link:hover,
  .custom-header-{{ ai_gen_id }}__nav-item:hover > .custom-header-{{ ai_gen_id }}__nav-link {
    color: var(--header-primary);
  }

  .custom-header-{{ ai_gen_id }}__chevron {
    width: 12px;
    height: 12px;
    transition: transform 0.2s ease;
  }

  .custom-header-{{ ai_gen_id }}__nav-item:hover .custom-header-{{ ai_gen_id }}__chevron {
    transform: rotate(180deg);
  }

  .custom-header-{{ ai_gen_id }}__dropdown {
    position: absolute;
    top: calc(100% + 1px);
    left: 50%;
    min-width: {{ block.settings.dropdown_width }}px;
    padding: 8px;
    background: var(--header-accent);
    border-radius: {{ block.settings.dropdown_radius }}px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 8px);
    transition:
      opacity 0.2s ease,
      visibility 0.2s ease,
      transform 0.2s ease;
  }

  .custom-header-{{ ai_gen_id }}__nav-item:hover .custom-header-{{ ai_gen_id }}__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  .custom-header-{{ ai_gen_id }}__dropdown-link {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 42px;
    padding: 10px 14px;
    color: var(--header-contrast);
    font-size: {{ block.settings.dropdown_font_size }}px;
    text-decoration: none;
    border-bottom: 1px solid var(--header-menu-border);
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      border-bottom-color 0.2s ease;
  }

  .custom-header-{{ ai_gen_id }}__dropdown-link:last-child {
    border-bottom: none;
  }

  .custom-header-{{ ai_gen_id }}__dropdown-link:hover,
  .custom-header-{{ ai_gen_id }}__dropdown-link:focus-visible {
    color: var(--header-accent);
    background: var(--header-background);
    border-bottom-color: var(--header-background);
  }

  .custom-header-{{ ai_gen_id }}__dropdown-link::after {
    content: "";
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 4px;
    background: currentColor;
    border-radius: 50%;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .custom-header-{{ ai_gen_id }}__dropdown-link:hover::after,
  .custom-header-{{ ai_gen_id }}__dropdown-link:focus-visible::after {
    opacity: 1;
  }

  .custom-header-{{ ai_gen_id }}__actions {
    display: flex;
    align-items: center;
    gap: {{ block.settings.action_gap }}px;
  }

  .custom-header-{{ ai_gen_id }}__cart {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    color: var(--header-accent);
    background: transparent;
    border: none;
    cursor: pointer;
    text-decoration: none;
  }

  .custom-header-{{ ai_gen_id }}__cart svg {
    width: {{ block.settings.cart_icon_size }}px;
    height: {{ block.settings.cart_icon_size }}px;
  }

  .custom-header-{{ ai_gen_id }}__cart-count {
    position: absolute;
    top: -4px;
    right: -4px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    background: var(--header-accent);
    color: var(--header-contrast);
    font-size: 11px;
    font-weight: 600;
    border-radius: 50%;
  }

  .custom-header-{{ ai_gen_id }}__shop-button {
    padding: 12px 24px;
    background: var(--header-accent);
    color: var(--header-contrast);
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-decoration: none;
    cursor: pointer;
    transition: opacity 0.2s ease;
    white-space: nowrap;
  }

  .custom-header-{{ ai_gen_id }}__shop-button:hover {
    opacity: 0.9;
  }

  .custom-header-{{ ai_gen_id }}__mobile-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    background: transparent;
    border: none;
    color: var(--header-primary);
    cursor: pointer;
  }

  .custom-header-{{ ai_gen_id }}__mobile-toggle svg {
    width: 24px;
    height: 24px;
  }

  .custom-header-{{ ai_gen_id }}__mobile-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 280px;
    height: 100vh;
    background: var(--header-nav-bg);
    transform: translateX(-100%);
    transition: transform 0.3s ease;
    z-index: 1000;
    overflow-y: auto;
  }

  .custom-header-{{ ai_gen_id }}__mobile-drawer.active {
    transform: translateX(0);
  }

  .custom-header-{{ ai_gen_id }}__mobile-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    z-index: 999;
  }

  .custom-header-{{ ai_gen_id }}__mobile-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .custom-header-{{ ai_gen_id }}__mobile-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px;
    border-bottom: 1px solid var(--header-menu-border);
  }

  .custom-header-{{ ai_gen_id }}__mobile-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    background: transparent;
    border: none;
    color: var(--header-primary);
    cursor: pointer;
  }

  .custom-header-{{ ai_gen_id }}__mobile-close svg {
    width: 20px;
    height: 20px;
  }

  .custom-header-{{ ai_gen_id }}__mobile-nav {
    padding: 20px;
  }

  .custom-header-{{ ai_gen_id }}__mobile-nav-item {
    margin-bottom: 20px;
  }

  .custom-header-{{ ai_gen_id }}__mobile-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 0;
    color: var(--header-secondary);
    font-size: {{ block.settings.navigation_font_size }}px;
    font-weight: {{ block.settings.navigation_font_weight }};
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .custom-header-{{ ai_gen_id }}__mobile-nav-link:hover {
    color: var(--header-primary);
  }

  .custom-header-{{ ai_gen_id }}__mobile-dropdown-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    padding: 0;
    background: transparent;
    border: none;
    color: var(--header-secondary);
    cursor: pointer;
  }

  .custom-header-{{ ai_gen_id }}__mobile-dropdown-toggle svg {
    width: 12px;
    height: 12px;
    transition: transform 0.2s ease;
  }

  .custom-header-{{ ai_gen_id }}__mobile-dropdown-toggle.active svg {
    transform: rotate(180deg);
  }

  .custom-header-{{ ai_gen_id }}__mobile-dropdown {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .custom-header-{{ ai_gen_id }}__mobile-dropdown.active {
    max-height: 500px;
  }

  .custom-header-{{ ai_gen_id }}__mobile-dropdown-link {
    display: block;
    padding: 10px 0 10px 20px;
    color: var(--header-secondary);
    font-size: {{ block.settings.dropdown_font_size }}px;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .custom-header-{{ ai_gen_id }}__mobile-dropdown-link:hover {
    color: var(--header-primary);
  }

  @media screen and (max-width: 989px) {
    .custom-header-{{ ai_gen_id }}__navigation {
      display: none;
    }

    .custom-header-{{ ai_gen_id }}__mobile-toggle {
      display: flex;
    }

    .custom-header-{{ ai_gen_id }}__brand {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
    }

    .custom-header-{{ ai_gen_id }}__shop-button {
      padding: 8px 16px;
      font-size: {{ block.settings.button_font_size | times: 0.9 }}px;
    }

    .custom-header-{{ ai_gen_id }}__inner {
      padding: 0 {{ block.settings.horizontal_padding | times: 0.5 }}px;
    }
  }
{% endstyle %}

<custom-header-{{ ai_gen_id }} class="custom-header-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="custom-header-{{ ai_gen_id }}__inner">
    <button class="custom-header-{{ ai_gen_id }}__mobile-toggle" aria-label="Open menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

    <a href="{{ block.settings.brand_link }}" class="custom-header-{{ ai_gen_id }}__brand">
      {{ block.settings.brand_text }}
    </a>

    <div class="custom-header-{{ ai_gen_id }}__right">
      <nav class="custom-header-{{ ai_gen_id }}__navigation">
        <div class="custom-header-{{ ai_gen_id }}__nav-item">
          <a href="{{ block.settings.learning_center_link }}" class="custom-header-{{ ai_gen_id }}__nav-link">
            {{ block.settings.learning_center_text }}
            <svg class="custom-header-{{ ai_gen_id }}__chevron" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M2 4l4 4 4-4"/>
            </svg>
          </a>
          <div class="custom-header-{{ ai_gen_id }}__dropdown">
            {% for i in (1..5) %}
              {% liquid
                assign dropdown_enabled_key = 'learning_center_dropdown_' | append: i | append: '_enabled'
                assign dropdown_text_key = 'learning_center_dropdown_' | append: i | append: '_text'
                assign dropdown_link_key = 'learning_center_dropdown_' | append: i | append: '_link'

                assign dropdown_enabled = block.settings[dropdown_enabled_key]
                assign dropdown_text = block.settings[dropdown_text_key]
                assign dropdown_link = block.settings[dropdown_link_key]
              %}
              {% if dropdown_enabled %}
                <a href="{{ dropdown_link }}" class="custom-header-{{ ai_gen_id }}__dropdown-link">
                  {{ dropdown_text }}
                </a>
              {% endif %}
            {% endfor %}
          </div>
        </div>

        <div class="custom-header-{{ ai_gen_id }}__nav-item">
          <a href="{{ block.settings.coffee_solutions_link }}" class="custom-header-{{ ai_gen_id }}__nav-link">
            {{ block.settings.coffee_solutions_text }}
            <svg class="custom-header-{{ ai_gen_id }}__chevron" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M2 4l4 4 4-4"/>
            </svg>
          </a>
          <div class="custom-header-{{ ai_gen_id }}__dropdown">
            {% for i in (1..5) %}
              {% liquid
                assign dropdown_enabled_key = 'coffee_solutions_dropdown_' | append: i | append: '_enabled'
                assign dropdown_text_key = 'coffee_solutions_dropdown_' | append: i | append: '_text'
                assign dropdown_link_key = 'coffee_solutions_dropdown_' | append: i | append: '_link'

                assign dropdown_enabled = block.settings[dropdown_enabled_key]
                assign dropdown_text = block.settings[dropdown_text_key]
                assign dropdown_link = block.settings[dropdown_link_key]
              %}
              {% if dropdown_enabled %}
                <a href="{{ dropdown_link }}" class="custom-header-{{ ai_gen_id }}__dropdown-link">
                  {{ dropdown_text }}
                </a>
              {% endif %}
            {% endfor %}
          </div>
        </div>

        <div class="custom-header-{{ ai_gen_id }}__nav-item">
          <a href="{{ block.settings.about_us_link }}" class="custom-header-{{ ai_gen_id }}__nav-link">
            {{ block.settings.about_us_text }}
          </a>
        </div>

        <div class="custom-header-{{ ai_gen_id }}__nav-item">
          <a href="{{ block.settings.blog_link }}" class="custom-header-{{ ai_gen_id }}__nav-link">
            {{ block.settings.blog_text }}
          </a>
        </div>
      </nav>

      <div class="custom-header-{{ ai_gen_id }}__actions">
        <a href="{{ routes.cart_url }}" class="custom-header-{{ ai_gen_id }}__cart">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 2L7 6M17 2l2 4M3 6h18M5 6l2 14h10l2-14"/>
          </svg>
          {% if cart.item_count > 0 %}
            <span class="custom-header-{{ ai_gen_id }}__cart-count">{{ cart.item_count }}</span>
          {% endif %}
        </a>

        <a href="{{ block.settings.shop_button_link }}" class="custom-header-{{ ai_gen_id }}__shop-button">
          <span class="custom-header-{{ ai_gen_id }}__shop-button-desktop">{{ block.settings.shop_button_text }}</span>
          <span class="custom-header-{{ ai_gen_id }}__shop-button-mobile">{{ block.settings.shop_button_mobile_text }}</span>
        </a>
      </div>
    </div>
  </div>

  <div class="custom-header-{{ ai_gen_id }}__mobile-overlay"></div>
  <div class="custom-header-{{ ai_gen_id }}__mobile-drawer">
    <div class="custom-header-{{ ai_gen_id }}__mobile-header">
      <span style="color: var(--header-primary); font-weight: 600;">Menu</span>
      <button class="custom-header-{{ ai_gen_id }}__mobile-close" aria-label="Close menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <nav class="custom-header-{{ ai_gen_id }}__mobile-nav">
      <div class="custom-header-{{ ai_gen_id }}__mobile-nav-item">
        <div style="display: flex; align-items: center; justify-content: space-between;">
          <a href="{{ block.settings.learning_center_link }}" class="custom-header-{{ ai_gen_id }}__mobile-nav-link" style="flex: 1;">
            {{ block.settings.learning_center_text }}
          </a>
          <button class="custom-header-{{ ai_gen_id }}__mobile-dropdown-toggle" data-dropdown="learning-center">
