  .custom-header-{{ ai_gen_id }}__shop-button-mobile {
    display: none;
  }

  @media screen and (max-width: 989px) {
    .custom-header-{{ ai_gen_id }}__shop-button-desktop {
      display: none;
    }

    .custom-header-{{ ai_gen_id }}__shop-button-mobile {
      display: inline;
    }
  }
</style>

<script>
  (function() {
    class CustomHeader{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.mobileToggle = this.querySelector('.custom-header-{{ ai_gen_id }}__mobile-toggle');
        this.mobileClose = this.querySelector('.custom-header-{{ ai_gen_id }}__mobile-close');
        this.mobileDrawer = this.querySelector('.custom-header-{{ ai_gen_id }}__mobile-drawer');
        this.mobileOverlay = this.querySelector('.custom-header-{{ ai_gen_id }}__mobile-overlay');
        this.dropdownToggles = this.querySelectorAll('.custom-header-{{ ai_gen_id }}__mobile-dropdown-toggle');
      }

      connectedCallback() {
        this.setupAccessibility();
        this.setupMobileMenu();
        this.setupMobileDropdowns();
      }

      setupAccessibility() {
        const navItems = this.querySelectorAll('.custom-header-{{ ai_gen_id }}__nav-item');
        
        navItems.forEach((item) => {
          const link = item.querySelector('.custom-header-{{ ai_gen_id }}__nav-link');
          const dropdown = item.querySelector('.custom-header-{{ ai_gen_id }}__dropdown');
          
          if (dropdown) {
            link.setAttribute('aria-haspopup', 'true');
            link.setAttribute('aria-expanded', 'false');
            
            item.addEventListener('mouseenter', () => {
              link.setAttribute('aria-expanded', 'true');
            });
            
            item.addEventListener('mouseleave', () => {
              link.setAttribute('aria-expanded', 'false');
            });
          }
        });
      }

      setupMobileMenu() {
        this.mobileToggle.addEventListener('click', () => {
          this.openMobileMenu();
        });

        this.mobileClose.addEventListener('click', () => {
          this.closeMobileMenu();
        });

        this.mobileOverlay.addEventListener('click', () => {
          this.closeMobileMenu();
        });
      }

      openMobileMenu() {
        this.mobileDrawer.classList.add('active');
        this.mobileOverlay.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      closeMobileMenu() {
        this.mobileDrawer.classList.remove('active');
        this.mobileOverlay.classList.remove('active');
        document.body.style.overflow = '';
      }

      setupMobileDropdowns() {
        this.dropdownToggles.forEach((toggle) => {
          toggle.addEventListener('click', () => {
            const dropdownId = toggle.getAttribute('data-dropdown');
            const dropdownContent = this.querySelector(`[data-dropdown-content="${dropdownId}"]`);
            
            toggle.classList.toggle('active');
            dropdownContent.classList.toggle('active');
          });
        });
      }
    }

    customElements.define('custom-header-{{ ai_gen_id }}', CustomHeader{{ ai_gen_id }});
  })();
</script>

